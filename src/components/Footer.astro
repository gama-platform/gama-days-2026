---
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <h3>Hosted by</h3>
    <div style="display: flex;">
      <a href="https://gama-platform.org/" target="_blank" rel="noopener">
        <img src={`${base}images/gama-logo.png`} alt="GAMA Platform" />
      </a>
      <a href="https://www.ird.fr" target="_blank" rel="noopener">
        <img src={`${base}images/ird.png`} alt="IRD" />
      </a>
      <a href="https://www.ummisco.fr" target="_blank" rel="noopener">
        <img src={`${base}images/UMMISCO.webp`} alt="UMMISCO" />
      </a>
    </div>
    <div class="footer-bottom">
      <span>&copy; {year} GAMA Days</span>
      <a href="mailto:gamadays2026@sciencesconf.org">Contact the organizers</a>
    </div>
  </div>
</footer>
